#check constraint
create table votes(
name varchar(25),
age int check (age>=18)
);

#insert age below 18
insert into votes values('sam',17);

#insert age equal to 18
insert into votes values('sri',18);

#insert age above 18
insert into votes values('sai',20);

select *from votes;

