show databases;
use students;
desc emp;
show tables;

select * from std_details;

delimiter //
create procedure student_mark()
begin
 select std_name,subject,stdmark
 from std_details;
end //
delimiter ;

call student_mark(); 

delimiter //
create procedure stud_mark(in sname varchar(15))
begin
 select std_name,subject,stdmark
 from std_details where std_name=sname;
end //
delimiter ;

call stud_mark('manoj');

delimiter $$
create procedure std_avg(out avgmark int)
begin
  select avg(stdmark) into avgmark 
  from std_details;
  end $$
  delimiter ;
  
  call std_avg(@stdaverage);
  select @stdaverage as avgmark;
  
  delimiter //
  create procedure empdetais(in id int,out ename varchar(15),
  out esal float)
  begin
    select empname into ename from empdetails where empid=id;
	select empsal into esal from empdetails where empid=id;
end //
delimiter ;

call empdetais(1,@empname,@empsal);
select @empname as ename, @empsal as esal;     

