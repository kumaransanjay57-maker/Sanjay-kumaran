# discount price calculation

delimiter //
create procedure discprice(inout price float)
begin
  set price = price - 20;
end //
delimiter ;

set @prc = 100; 
call discprice(@prc);
select @prc as discount;  

delimiter $$
create procedure count_val(in inc int,inout counter int)
begin
  set counter = counter + inc;
end $$
delimiter ;

set @cou = 1;
call count_val(3,@cou);
select @cou as counted;

